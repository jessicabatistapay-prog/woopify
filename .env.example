# ====== Bắt buộc ======
# Mật khẩu Postgres (chuỗi ngẫu nhiên dài)
POSTGRES_PASSWORD=doi-mat-khau-nay
# Khóa mã hóa Consumer Key/Secret trong DB (≥ 32 ký tự). Tạo: openssl rand -base64 48
APP_SECRET=
# Địa chỉ HTTPS công khai của backend (WooCommerce gửi webhook tới đây)
PUBLIC_URL=https://api.shop-cua-ban.com

# ====== Push notification ======
# Bắt buộc nếu bật "Enhanced Security for Push Notifications" trong tài khoản Expo
EXPO_ACCESS_TOKEN=
# Số giây chờ gom cập nhật trước khi báo "Đơn mới" (để biết đơn đã thanh toán chưa)
PUSH_COALESCE_SECONDS=8

# ====== Tùy chọn: cấu hình shop bằng biến môi trường thay vì nhập trong app ======
# WC_STORE_URL=https://shop-cua-ban.com
# WC_CONSUMER_KEY=ck_xxx
# WC_CONSUMER_SECRET=cs_xxx
# WC_WEBHOOK_SECRET=   (để trống: backend tự tạo và tự cấu hình webhook)

# ====== Khác ======
RECONCILE_INTERVAL_MINUTES=10
SESSION_TTL_DAYS=60
LOG_LEVEL=info
API_PORT=3000
