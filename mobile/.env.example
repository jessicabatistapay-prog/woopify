# Địa chỉ HTTPS của backend (điền sẵn ở màn hình đăng nhập)
EXPO_PUBLIC_API_URL=https://api.shop-cua-ban.com
# Lấy sau khi chạy: npx eas-cli@latest init
EXPO_PUBLIC_EAS_PROJECT_ID=
# Định danh app (đổi thành tên miền của bạn, ví dụ com.tenshop.admin)
APP_BUNDLE_ID=com.example.wooadmin
# Đường dẫn google-services.json (Firebase) cho push Android
GOOGLE_SERVICES_JSON=./google-services.json
